{
  "name": "doodleforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite apps/web --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:api": "tsx apps/api/src/server.ts",
    "build": "vite build apps/web --config apps/web/vite.config.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "record:phase2-fixtures": "tsx eval/fixtures/record-phase2-fixtures.ts",
    "mini-eval": "tsx eval/mini-eval.ts",
    "schemas:export": "tsx scripts/export-schemas.ts",
    "spike": "tsx eval/spikes/run-spikes.ts --mode fixture"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@octokit/rest": "^22.0.1",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "elkjs": "^0.12.0",
    "fastify": "^5.12.7",
    "heic2any": "^0.0.4",
    "immer": "^11.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
