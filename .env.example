# Native Google Gen AI SDK; the model ID is fixed to gemini-3.8-flash.
# The server accepts GEMMA_API_KEY temporarily as a migration fallback.
# Never put credentials in client-side code or commit real tokens.
API_PORT=4174
GEMINI_API_KEY=

# GitHub credentials are API-server only. Keep dry-run enabled until issue payloads are reviewed.
GITHUB_TOKEN=
GITHUB_REPO_ALLOWLIST=
GITHUB_DRY_RUN=true

# Jira credentials stay on the API server. Dry-run defaults on and needs no credentials.
# JIRA_HOST_ALLOWLIST accepts comma-separated bare hostnames, such as example.atlassian.net.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_HOST_ALLOWLIST=
JIRA_PROJECT_ALLOWLIST=
JIRA_DRY_RUN=true

